    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "dompurify": "^3.4.17",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "marked": "^18.1.2",
    "svelte": "^5.57.3",
